<div>
    <h3>Register</h3>
    <form id="registerForm">
        <div class="form-floating mb-3">
            <input type="text" id="username" class="form-control-sm" placeholder="UserName" required />
        </div>
        <div class="form-floating mb-3">
            <input type="password" id="password" class="form-control-sm" placeholder="Password" required />
        </div>
        <button type="submit" class="btn btn-success">Register</button>
    </form>
    <p id="registerError" class="text-danger"></p>
</div>

<script>
    document.getElementById("registerForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const username = document.getElementById("username").value;
        const password = document.getElementById("password").value;

        const response = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userName: username, password: password }),
        });

        const message = await response.text();
        if (response.ok) {
            alert(message);
            window.location.href = "/api/Auth/login";
        } else {
            document.getElementById("registerError").textContent = message;
        }
    });
</script>
